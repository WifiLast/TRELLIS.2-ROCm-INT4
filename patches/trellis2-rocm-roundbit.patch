+#!/usr/bin/env bash
+# Run TRELLIS.2 on the AMD RX 7900 XTX (ROCm) with the repo venv
+# (.venv sits on top of the py310_amd conda env, see README.md).
+#
+#   ./run_amd.sh example.py
+#   ./run_amd.sh app.py
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PY="${TRELLIS_PYTHON:-$HERE/.venv/bin/python}"
+
+# ~/.local carries an old ROCm torch that would shadow the env's torch.
+export PYTHONNOUSERSITE=1
+export TRITON_DEFAULT_BACKEND="${TRITON_DEFAULT_BACKEND:-amd}"
+export HIP_VISIBLE_DEVICES="${HIP_VISIBLE_DEVICES:-0}"
+# expandable_segments corrupts tensors on this ROCm stack.
+unset PYTORCH_ALLOC_CONF PYTORCH_HIP_ALLOC_CONF PYTORCH_CUDA_ALLOC_CONF
+# Shell debug defaults that only add noise / fill /tmp with comgr temp files.
+unset TORCH_LOGS AMD_COMGR_SAVE_TEMPS AMD_COMGR_EMIT_VERBOSE_LOGS
+export AMD_LOG_LEVEL=0
+export OPENCV_IO_ENABLE_OPENEXR=1
+
+cd "$HERE"
+exec "$PY" "$@"
