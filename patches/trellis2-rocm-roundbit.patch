+def load_hdri(path: str) -> np.ndarray:
+    """
+    Read an .exr environment map as linear float32 RGB (H, W, 3).
+
+    Not every OpenCV wheel is built with OpenEXR (cv2.imread then returns
+    None), so fall back to the OpenEXR bindings. imageio is no substitute: its
+    ffmpeg reader tone-maps the file to uint8.
+    """
+    import os
+    os.environ.setdefault('OPENCV_IO_ENABLE_OPENEXR', '1')
+    import cv2
+    img = cv2.imread(path, cv2.IMREAD_UNCHANGED)
+    if img is not None:
+        return cv2.cvtColor(img, cv2.COLOR_BGR2RGB).astype(np.float32)
+    try:
+        import OpenEXR, Imath
+    except ImportError as e:
+        raise RuntimeError(
+            f"Cannot read {path}: this OpenCV build has no OpenEXR support and the "
+            f"OpenEXR python package is missing (pip install OpenEXR)."
+        ) from e
+    f = OpenEXR.InputFile(path)
+    dw = f.header()['dataWindow']
+    w, h = dw.max.x - dw.min.x + 1, dw.max.y - dw.min.y + 1
+    pt = Imath.PixelType(Imath.PixelType.FLOAT)
+    chans = [np.frombuffer(f.channel(c, pt), dtype=np.float32).reshape(h, w) for c in 'RGB']
+    f.close()
+    return np.ascontiguousarray(np.stack(chans, axis=-1))
